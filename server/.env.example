GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCDeFGhijKLmnoPQRstuVWxyz
PORT=8787
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret
# Speech-to-text for "คุยกับ Claude AI ผ่าน LINE" voice messages — OpenAI's
# Whisper API (separate provider from ANTHROPIC_API_KEY, since Anthropic's
# Messages API has no audio content-block support). Optional — voice input
# via LINE just replies with a clear Thai error if this isn't set; typed
# text commands work either way.
OPENAI_API_KEY=sk-your-openai-api-key
# UptimeRobot read-only API key — powers the "🖥️ สถานะเซิร์ฟเวอร์" card in
# my-buildings.html's platform-admin "🔧 ทุกตึกในระบบ (Server only)" section
# (2026-07-29). UptimeRobot pings GET /api/scheduler/run every 20 min to
# both keep Render's free tier awake AND trigger the scheduled-message
# check (see server/routes/scheduler.js) — this key just lets us pull that
# monitor's own up/down status back into our own dashboard instead of
# needing to open uptimerobot.com separately. Get a "Read-only API key"
# (not "Main API key" — read-only can't modify/delete monitors) from
# UptimeRobot's dashboard: Integrations & API > Main API keys.
UPTIMEROBOT_API_KEY=ur1234567-abcdef1234567890abcdef12
